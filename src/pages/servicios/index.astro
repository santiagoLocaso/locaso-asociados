---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceCard from "../../components/common/ServiceCard.astro";
import { services } from "../../data/services";
---

<MainLayout
  title="Servicios | Locaso y Asociados"
  description="Servicios jurídicos en constitución de sociedades, fundaciones, asociaciones civiles y sociedades extranjeras."
>
  <section class="bg-(--color-dark) px-6 pb-24 pt-40 text-white">
    <div class="mx-auto max-w-7xl">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-(--color-primary)"
      >
        Servicios
      </p>

      <h1 class="max-w-4xl text-4xl font-bold leading-tight md:text-6xl">
        Asesoramiento jurídico para organizaciones, empresas y profesionales
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
        Brindamos asistencia integral en trámites societarios, entidades
        civiles, fundaciones, asociaciones y sociedades extranjeras ante los
        organismos correspondientes.
      </p>
    </div>
  </section>

  <section class="bg-slate-50 px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 md:grid-cols-3">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>

  <section class="bg-white px-6 py-24">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-2">
      <div>
        <p
          class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-(--color-primary)"
        >
          Atención profesional
        </p>

        <h2 class="text-3xl font-bold text-slate-950 md:text-5xl">
          También acompañamos a contadores, abogados y asesores
        </h2>
      </div>

      <div>
        <p class="text-lg leading-8 text-slate-600">
          El estudio brinda soporte a otros profesionales que requieren
          asistencia específica en trámites ante IGJ, constitución de
          sociedades, reformas, inscripciones y regularizaciones.
        </p>

        <a
          href="/contacto"
          class="mt-8 inline-flex rounded-full bg-(--color-dark) px-7 py-3 font-semibold text-white transition hover:bg-(--color-navy)"
        >
          Realizar consulta
        </a>
      </div>
    </div>
  </section>
</MainLayout>
