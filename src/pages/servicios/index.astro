---
import MainLayout from "../../layouts/MainLayout.astro";
import ServiceCard from "../../components/common/ServiceCard.astro";
import { services } from "../../data/services";
---

<MainLayout
  title="Servicios | Locaso y Asociados"
  description="Áreas de práctica de Locaso y Asociados: derecho societario y derecho judicial."
>
  <section class="bg-(--color-dark) px-6 pb-24 pt-40 text-white">
    <div class="mx-auto max-w-7xl">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-(--color-primary)"
      >
        Servicios
      </p>

      <h1 class="max-w-4xl text-4xl font-bold leading-tight md:text-6xl">
        Áreas de práctica
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
        Brindamos asesoramiento jurídico integral en derecho societario y
        jurídico, acompañando a empresas, organizaciones, profesionales y
        particulares.
      </p>
    </div>
  </section>

  <section class="bg-slate-50 px-6 py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 md:grid-cols-2">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>
</MainLayout>
