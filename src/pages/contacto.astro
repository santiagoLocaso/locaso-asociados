---
import MainLayout from "../layouts/MainLayout.astro";
import { company } from "../config/company";
---

<MainLayout
  title="Contacto | Locaso y Asociados"
  description="Contactá a Locaso y Asociados para recibir asesoramiento jurídico en sociedades, fundaciones, asociaciones civiles y sociedades extranjeras."
>
  <section class="bg-(--color-dark) px-6 pb-24 pt-40 text-white">
    <div class="mx-auto max-w-7xl">
      <p
        class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-(--color-primary)"
      >
        Contacto
      </p>

      <h1 class="max-w-4xl text-4xl font-bold leading-tight md:text-6xl">
        REALIZÁ TU CONSULTA
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
        Completá el formulario y nos pondremos en contacto para analizar tu
        caso.
      </p>
    </div>
  </section>

  <section class="bg-white px-6 py-24">
    <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p
          class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-(--color-primary)"
        >
          Información
        </p>

        <h2 class="text-3xl font-bold text-slate-950 md:text-5xl">
          Ponete en contacto con nosotros
        </h2>

        <div class="space-y-8 *:mt-12">
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-wide text-slate-500"
            >
              📧 EMAIL
            </p>

            <p class="text-lg font-semibold text-slate-900">
              {company.email}
            </p>
          </div>

          <div>
            <p
              class="text-sm font-semibold uppercase tracking-wide text-slate-500"
            >
              📞 TELÉFONO
            </p>

            <p class="text-lg font-semibold text-slate-900">
              {company.phone}
            </p>
          </div>

          <div>
            <p
              class="text-sm font-semibold uppercase tracking-wide text-slate-500"
            >
              📍 OFICINAS
            </p>

            <p class="mt-1 text-lg leading-7 text-slate-700">
              {company.address}
              <br />
              {company.city}
            </p>
          </div>
        </div>
      </div>

      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/gracias"
        class="rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm md:p-8"
      >
        <input type="hidden" name="form-name" value="contacto" />

        <p class="hidden">
          <label>
            No completar:
            <input name="bot-field" />
          </label>
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-900">
              Nombre
            </label>
            <input
              type="text"
              name="nombre"
              required
              class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-4 outline-none transition focus:border-(--color-primary)"
            />
          </div>

          <div>
            <label class="mb-2 block text-sm font-semibold text-slate-900">
              Email
            </label>
            <input
              type="email"
              name="email"
              required
              class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-4 outline-none transition focus:border-(--color-primary)"
            />
          </div>
        </div>

        <div class="mt-5">
          <label class="mb-2 block text-sm font-semibold text-slate-900">
            Teléfono
          </label>
          <input
            type="tel"
            name="telefono"
            class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-4 outline-none transition focus:border-(--color-primary)"
          />
        </div>

        <div class="mt-5">
          <label class="mb-2 block text-sm font-semibold text-slate-900">
            Servicio de interés
          </label>
          <select
            name="servicio"
            required
            class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-4 outline-none transition focus:border-(--color-primary)"
          >
            <option value="">Seleccionar servicio</option>
            <option value="Derecho Societario">Derecho Societario</option>
            <option value="Derecho Judicial">Jurídico</option>
            <option value="Consulta general">Consulta general</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <div class="mt-5">
          <label class="mb-2 block text-sm font-semibold text-slate-900">
            Consulta
          </label>
          <textarea
            name="consulta"
            rows="6"
            required
            class="w-full resize-none rounded-2xl border border-slate-300 bg-white px-4 py-4 outline-none transition focus:border-(--color-primary)"
          ></textarea>
        </div>

        <button
          type="submit"
          class="mt-6 w-full rounded-full bg-(--color-primary) px-7 py-4 font-semibold text-slate-950 transition hover:bg-(--color-primary-hover)"
        >
          Enviar consulta
        </button>
      </form>
    </div>
  </section>
</MainLayout>
