---
import { services } from "../../data/services";
import ServiceCard from "../common/ServiceCard.astro";
---

<section class="bg-slate-50 px-6 py-24">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-(--color-primary-dark)"
      >
        Servicios
      </p>

      <h2 class="text-3xl font-bold text-slate-950 md:text-5xl">
        Asesoramiento jurídico integral para empresas y particulares
      </h2>

      <p class="mt-5 text-lg leading-8 text-slate-600">
        Brindamos asesoramiento jurídico integral en derecho societario y
        jurídico, acompañando a empresas, organizaciones y particulares en cada
        etapa de su actividad. Intervenimos tanto en la prevención como en la
        resolución de conflictos, con experiencia en sociedades comerciales,
        entidades civiles, fundaciones, asociaciones, sociedades extranjeras,
        derecho civil, laboral y comercial.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {services.map((service) => <ServiceCard {...service} />)}
    </div>

    <div class="mt-12">
      <a
        href="/servicios"
        class="inline-flex rounded-full bg-(--color-dark) px-7 py-3 font-semibold text-white transition hover:bg-(--color-navy)"
      >
        Ver todos los servicios
      </a>
    </div>
  </div>
</section>
