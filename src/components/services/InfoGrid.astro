---
const { label, title, description, items } = Astro.props;
---

<section class="bg-slate-50 px-6 py-24">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-3xl">
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-(--color-primary)"
      >
        {label}
      </p>

      <h2 class="text-3xl font-bold text-slate-950 md:text-5xl">
        {title}
      </h2>

      {
        description && (
          <p class="mt-5 text-lg leading-8 text-slate-600">{description}</p>
        )
      }
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        items.map(
          (item: {
            badge: unknown;
            title: unknown;
            description: unknown;
            items: any[];
          }) => (
            <article class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm">
              {item.badge && (
                <span class="text-sm font-semibold uppercase tracking-[0.2em] text-(--color-primary)">
                  {item.badge}
                </span>
              )}

              <h3 class="mt-3 text-2xl font-bold text-slate-950">
                {item.title}
              </h3>

              {item.description && (
                <p class="mt-4 leading-7 text-slate-600">{item.description}</p>
              )}

              {item.items && (
                <ul class="mt-6 space-y-3 text-slate-600">
                  {item.items.map((point: unknown) => (
                    <li class="flex gap-3">
                      <span class="mt-1 text-(--color-primary)">•</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ),
        )
      }
    </div>
  </div>
</section>
