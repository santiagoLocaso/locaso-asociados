---
const { title, description, href } = Astro.props;
---

<a
  href={href}
  class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:border-(--color-primary) hover:shadow-xl"
>
  <div
    class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-(--color-dark) text-(--color-primary)"
  >
    §
  </div>

  <h3
    class="text-xl font-bold text-slate-950 group-hover:text-(--color-primary)"
  >
    {title}
  </h3>

  <p class="mt-4 leading-7 text-slate-600">
    {description}
  </p>

  <span
    class="mt-6 inline-flex font-semibold text-slate-950 group-hover:text-(--color-primary)"
  >
    Ver más →
  </span>
</a>
