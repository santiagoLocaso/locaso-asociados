---
import { company } from "../../config/company";
---

<footer class="bg-(--color-dark) px-6 py-10 text-slate-300">
  <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-3">
    <div>
      <h3 class="text-lg font-semibold text-white">{company.name}</h3>

      <p class="mt-3 text-sm leading-6">
        Estudio jurídico especializado en asesoramiento integral en derecho
        societario y judicial, brindando soluciones legales para empresas,
        organizaciones y particulares.
      </p>
    </div>

    <div>
      <h4 class="font-semibold text-white">Áreas de práctica</h4>

      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href="/servicios/societario" class="hover:text-(--color-primary)">
            Derecho Societario
          </a>
        </li>

        <li>
          <a href="/servicios/judicial" class="hover:text-(--color-primary)">
            Derecho Judicial
          </a>
        </li>

        <li>
          <a href="/contacto" class="hover:text-(--color-primary)">
            Solicitar asesoramiento
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="font-semibold text-white">Contacto</h4>

      <p class="mt-3 text-sm">
        <strong>Email:</strong>
        {company.email}
      </p>

      <p class="mt-3 text-sm">
        <strong>Teléfono:</strong>
        {company.phone}
      </p>

      <p class="mt-3 text-sm">
        <strong>WhatsApp:</strong>
        {company.whatsapp}
      </p>

      <p class="mt-3 text-sm">
        <strong>Dirección:</strong>
        {company.address}
      </p>

      <p class="mt-2 text-sm">{company.city}</p>
    </div>
  </div>

  <div
    class="mx-auto mt-10 max-w-7xl border-t border-white/10 pt-6 text-center text-sm text-slate-500"
  >
    © {new Date().getFullYear()}
    {company.name}. Todos los derechos reservados. Desarrollado por <a
      href="https://santiagolocaso.netlify.app">Santiago Locaso Turiaci</a
    >
  </div>
</footer>
