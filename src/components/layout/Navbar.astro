---
import { company } from "../../config/company";
import { navigation } from "../../config/navigation";
---

<header
  class="fixed top-0 left-0 z-50 w-full border-b border-white/10 bg-(--color-dark) backdrop-blur"
>
  <nav
    class="relative mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
  >
    <a href="/" class="flex flex-col leading-none">
      <span
        class="text-[22px] font-semibold tracking-wide text-white md:text-[30px]"
      >
        {company.shortName}
        <span class="text-(--color-primary)"> y Asociados</span>
      </span>
      <span
        class="mt-1 text-[11px] font-medium uppercase tracking-[0.45em] text-slate-400 md:text-[15px]"
      >
        ABOGADOS
      </span>
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class="text-[18px] text-slate-200 hover:text-(--color-primary)"
          >
            {item.title}
          </a>
        ))
      }
    </div>
    <a
      href="/contacto"
      class="hidden rounded-full bg-(--color-primary) px-5 py-2 text-[18px] font-semibold text-slate-950 transition hover:bg-(--color-primary-hover) md:block"
    >
      Consultar
    </a>
    <details class="group md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-white/20 bg-white/5 text-white transition hover:border-(--color-primary)"
      >
        <span class="text-2xl leading-none group-open:hidden">☰</span>
        <span class="hidden text-2xl leading-none group-open:block">×</span>
      </summary>

      <div
        class="fixed inset-0 z-[-1] h-screen w-screen overflow-y-auto bg-(--color-dark) px-6 pb-10 pt-28 shadow-2xl"
      >
        <div class="mx-auto flex max-w-md flex-col gap-5 pt-6">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                class="rounded-2xl border border-white/10 px-5 py-5 text-base font-semibold text-slate-200 transition hover:border-(--color-primary) hover:bg-white/10 hover:text-(--color-primary)"
              >
                {item.title}
              </a>
            ))
          }

          <a
            href="/contacto"
            class="mt-2 rounded-2xl bg-(--color-primary) px-5 py-4 text-center text-base font-semibold text-slate-950 transition hover:bg-(--color-primary-hover)"
          >
            Solicitar consulta
          </a>
        </div>
      </div>
    </details>
  </nav>
</header>
